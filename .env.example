# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://eldercare_user:securepassword@localhost:5432/eldercare_db?schema=public"

# Authentication Security
JWT_SECRET=eldercare_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
